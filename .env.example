# Neuromancing environment — copy to .env on each target host and fill in.
# .env is host-local and NEVER committed (it's gitignored).

# ---- Core service wiring (defaults match docker-compose service names) ----
POSTGRES_USER=neuro
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=neuromancing
# App DB URL (async driver). Host "db" resolves inside the compose network.
DATABASE_URL=postgresql+asyncpg://neuro:change-me-locally@db:5432/neuromancing
# Sync URL for Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg://neuro:change-me-locally@db:5432/neuromancing

REDIS_URL=redis://redis:6379/0

# Temporal (self-hosted in compose, or Temporal Cloud in prod)
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=neuromancing

# ---- Internal service seam ----
# game-api -> trade-api. TRADE_API_URL is the internal base URL.
TRADE_API_URL=http://trade-api:8000
# Read-scoped token the thin Next.js BFF is allowed to hold.
GAME_API_PUBLIC_TOKEN=change-me-read-token
# Privileged token for order-mutating trade-api calls — server-side only,
# NEVER exposed to the browser/BFF.
TRADE_API_SERVICE_TOKEN=change-me-privileged-token

# ---- Alpaca (market data only at MVP; paper/live keys are data-scoped) ----
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex

# ---- Price platform (TODO #4a) ----
# Parquet bar archive root (matches the compose `bardata` volume mount).
BARDATA_DIR=/data/bars
# Recent bars kept per (timeframe, symbol) in the Redis hot cache.
PRICE_HOT_LEN=500
# Timeframes fetched/served (native from Alpaca, never derived).
PRICE_TIMEFRAMES=1m,5m,1h,1d
# Latest-quote TTL (~26h so quotes survive overnight/weekends).
QUOTE_TTL_S=93600
# Active equity universe -> game-api/app/ingest/symbols/<name>.txt (diversified|russell1000).
PRICE_UNIVERSE=diversified
# Per-timeframe backfill depth (days) and live poll cadence (seconds).
# NOTE: IEX (free) history is limited; deep 1m history may need a SIP subscription.
PRICE_BACKFILL_DAYS=1m:5,5m:20,1h:120,1d:365
PRICE_POLL_SECONDS=1m:60,5m:300,1h:3600,1d:86400
# Parquet durability flush + gap-fill cadence (seconds); Alpaca batch size.
PRICE_FLUSH_SECONDS=300
PRICE_GAPFILL_SECONDS=1800
PRICE_BATCH_SIZE=100

# ---- LLM provider seam (bring your own OpenAI-compatible provider) ----
# Default is Ollama Cloud. Switch providers WITHOUT code changes; Anthropic is
# reachable THROUGH OpenRouter (no native Anthropic client). Leave these blank to
# keep the Ollama defaults below. See game-api/app/llm/provider.py.
#   LLM_PROVIDER=ollama|openrouter|local|custom
#   LLM_BASE_URL=            # required for provider=custom (else the preset is used)
#   LLM_API_KEY=            # generic key; falls back to OLLAMA_API_KEY for provider=ollama
#   LLM_MODEL=              # override the standard/flash model (else OLLAMA_MODEL)
#   LLM_REASONING_MODEL=    # override the evolve reasoner model (else OLLAMA_REASONING_MODEL)
#   LLM_REFERER= / LLM_TITLE=   # optional OpenRouter attribution headers
# Example (OpenRouter fronting an Anthropic model):
#   LLM_PROVIDER=openrouter / LLM_API_KEY=sk-or-... / LLM_MODEL=anthropic/claude-sonnet-5
LLM_PROVIDER=ollama

# ---- Ollama Cloud (default provider) ----
# OpenAI-COMPATIBLE endpoint (note the /v1)
OLLAMA_HOST=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4-flash:0731
# Per-call hard timeout — MUST stay < 75s (the decide-activity timeout).
OLLAMA_TIMEOUT_S=45
OLLAMA_MAX_CONCURRENCY=4
# Optional USD pricing per 1M tokens (leave 0 if unknown; token budget still enforces).
OLLAMA_PRICE_PER_MTOK_IN=0
OLLAMA_PRICE_PER_MTOK_OUT=0
# Enforced circuit-breaker: daily token budgets (per-agent + global).
LLM_DAILY_TOKEN_BUDGET_AGENT=2000000
LLM_DAILY_TOKEN_BUDGET_GLOBAL=20000000
# Advisory USD budgets (for dashboards).
LLM_DAILY_BUDGET_USD=25
LLM_AGENT_DAILY_BUDGET_USD=2

# ---- Deep agents / strategy evolution (TODO #3) ----
# OFF by default; agents keep a trade diary regardless, but they only self-evolve
# strategies when this is on AND a reasoning model is set. Evolution is silent on Chirp.
EVOLUTION_ENABLED=false
# Strong reasoning model for strategy design (Ollama Cloud). Empty -> falls back to
# OLLAMA_MODEL (flash). Set to a larger model to get real "deep" reasoning.
OLLAMA_REASONING_MODEL=
OLLAMA_REASONING_TIMEOUT_S=120
LLM_DAILY_TOKEN_BUDGET_EVOLUTION=5000000
# Trigger: fires hourly; per-agent gate = post-session-close + >=24h + enough diary.
EVOLUTION_SCHEDULE_SECONDS=3600
EVOLUTION_MIN_HOURS_BETWEEN=24
EVOLUTION_CRYPTO_UTC_HOUR=0
EVOLUTION_MIN_DIARY_EPISODES=10
# Adoption gate (out-of-sample, both walk-forward windows).
EVOLUTION_MIN_TRADES=5
EVOLUTION_RETURN_MARGIN=0.02
EVOLUTION_MAX_DD=0.40
EVOLUTION_BACKTEST_SYMBOLS=6

# ---- Crypto donation tallying (watch-only; NO private keys here) ----
DONATION_BTC_XPUB=
DONATION_ETH_XPUB=
COINGECKO_API_KEY=

# ---- Web ----
# Public base URL of the site (used by Next.js).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Internal URL the BFF uses to reach game-api.
GAME_API_URL=http://game-api:8000
